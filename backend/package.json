{
  "name": "@sagip/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "node scripts/dev.mjs",
    "migrate": "tsx src/migrate.ts",
    "provision-responder": "tsx src/provisionResponder.ts",
    "provision-gateway-authority": "tsx src/provisionGatewayAuthority.ts",
    "build:console": "tsc -p tsconfig.browser.json && node scripts/build-responder-console.mjs",
    "test:browser": "npm run build:console && playwright test test/browser",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "build:neon": "npm run build:console && node scripts/build-neon-function.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.11.2",
    "pg": "^8.16.3",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^8.57.1",
    "pg-mem": "^3.0.5",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "esbuild": "0.28.2"
  }
}
